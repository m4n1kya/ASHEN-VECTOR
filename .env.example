# ASHEN-VECTOR Configuration
# Copy this file to .env and adjust values for your local environment.

# Application
APP_NAME=ASHEN-VECTOR
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Qlib Data Provider
# Path to the Qlib binary dataset directory.
# Relative paths are resolved from the project root.
QLIB_PROVIDER_URI=../qlib/qlib_bin
QLIB_REGION=us

# API Server
API_HOST=127.0.0.1
API_PORT=8000

# Directories (relative to project root)
MODEL_DIR=./artifacts/models
CACHE_DIR=./artifacts/cache
LOG_DIR=./logs

# Prediction defaults
DEFAULT_HORIZON=5
